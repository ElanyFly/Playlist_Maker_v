<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mediaPlaylists"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".media.presentation.PlaylistFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/leftGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="@dimen/padding_24dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/rightGuideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="@dimen/padding_24dp" />



    <Button
        android:id="@+id/mediaBtnNewPlaylist"
        style="@style/RefreshButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/refresh_button_height"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginTop="@dimen/padding_24dp"
        android:text="@string/media_new_playlist"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/leftGuideline"
        app:layout_constraintEnd_toEndOf="@id/rightGuideline"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/padding_16dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/mediaBtnNewPlaylist"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="5"
        tools:listitem="@layout/playlist_view"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/mediaEmptyPlaylistsImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/padding_16dp"
        android:src="@drawable/nf_icon"
        android:paddingTop="82dp"
        app:layout_constraintTop_toTopOf="@id/mediaBtnNewPlaylist"
        app:layout_constraintStart_toStartOf="@id/leftGuideline"
        app:layout_constraintEnd_toEndOf="@id/rightGuideline"
        android:visibility="visible"/>

    <TextView
        android:id="@+id/mediaEmptyPlaylistsText"
        style="@style/ErrorMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="@string/media_no_playlists"
        app:layout_constraintTop_toBottomOf="@id/mediaEmptyPlaylistsImg"
        app:layout_constraintStart_toStartOf="@id/leftGuideline"
        app:layout_constraintEnd_toEndOf="@id/rightGuideline"
        android:visibility="visible"
        />

</androidx.constraintlayout.widget.ConstraintLayout>