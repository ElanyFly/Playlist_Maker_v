<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_activity_white"
    tools:context=".media.presentation.MediaFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_16dp"
        android:layout_marginTop="@dimen/padding_14dp"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/padding_14dp">

        <TextView
            style="@style/ScreenHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:text="@string/media_header"
            android:textColor="@color/text_dark" />

    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        style="@style/MediaTabLayout"
        app:tabTextAppearance="@style/MediaTabLayout"
        android:id="@+id/mediaTabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tab_layout_height"
        android:layout_marginHorizontal="@dimen/padding_16dp"
        app:tabIndicatorColor="@color/text_dark"
        />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/mediaViewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        />




</LinearLayout>