<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mediaFavoriteTracks"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_activity_white"
    tools:context=".media.presentation.PlaylistFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/mediaEmptyFavList"
        android:orientation="vertical"
        android:gravity="top|center"
        android:visibility="gone">

        <ImageView
            android:id="@+id/mediaNoFavsImg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/padding_16dp"
            android:src="@drawable/nf_icon"
            android:paddingTop="@dimen/paddingTop_100dp"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mediaNoFavsText"
            style="@style/ErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="@string/media_empty_favorites"
            app:layout_constraintTop_toBottomOf="@id/mediaNoFavsImg"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintVertical_chainStyle="packed"
        tools:itemCount="10"
        tools:listitem="@layout/track_view" />

</androidx.constraintlayout.widget.ConstraintLayout>