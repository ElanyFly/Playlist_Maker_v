<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlistInfo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".media.presentation.playlist.PlaylistInfoFragment">

    <ImageView
        android:id="@+id/coverUri"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:src="@tools:sample/avatars" />

    <FrameLayout
        android:id="@+id/backArrow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/padding_14dp"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/arrow_back"
            app:tint="@color/text_dark" />

    </FrameLayout>

    <TextView
        android:id="@+id/playlistName"
        style="@style/PlaylistInfoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_16dp"
        android:layout_marginTop="@dimen/padding_24dp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        app:layout_constraintTop_toBottomOf="@id/coverUri"
        tools:text="Best Songs Whatever "/>

    <TextView
        android:id="@+id/playlistDescription"
        style="@style/PlaylistInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_16dp"
        android:layout_marginTop="@dimen/padding_8dp"
        app:layout_constraintTop_toBottomOf="@id/playlistName"
        tools:text="209202"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/innerConstraint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/padding_16dp"
        android:paddingTop="@dimen/padding_8dp"
        app:layout_constraintTop_toBottomOf="@id/playlistDescription"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/totalTrackTime"
            style="@style/PlaylistInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="300 минут"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintWidth_default="wrap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/trackCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/dot"/>

        <ImageView
            android:id="@+id/dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:src="@drawable/dot_icon"
            app:layout_constraintTop_toTopOf="@id/totalTrackTime"
            app:layout_constraintBottom_toBottomOf="@id/totalTrackTime"
            app:layout_constraintEnd_toStartOf="@id/trackCount"
            app:layout_constraintStart_toEndOf="@id/totalTrackTime"
            app:tint="@color/text_dark" />

        <TextView
            android:id="@+id/trackCount"
            style="@style/PlaylistInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@id/totalTrackTime"
            app:layout_constraintBottom_toBottomOf="@id/totalTrackTime"
            app:layout_constraintLeft_toRightOf="@+id/dot"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/dot"
            tools:text="98 треков" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/shareIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/share_icon"
        app:tint="@color/text_dark"
        android:layout_marginTop="@dimen/padding_16dp"
        android:layout_marginStart="@dimen/padding_16dp"
        app:layout_constraintTop_toBottomOf="@id/innerConstraint"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
        android:id="@+id/tripleIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/triple_icon"
        app:tint="@color/text_dark"
        android:layout_marginTop="@dimen/padding_16dp"
        android:layout_marginHorizontal="@dimen/padding_16dp"
        app:layout_constraintTop_toBottomOf="@id/innerConstraint"
        app:layout_constraintStart_toEndOf="@id/shareIcon"/>

    

</androidx.constraintlayout.widget.ConstraintLayout>