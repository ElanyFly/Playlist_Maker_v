<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/mediaFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistmaker.search.presentation.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
        <action
            android:id="@+id/action_searchFragment_to_audioPlayerFragment"
            app:destination="@id/audioPlayerFragment" />
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.playlistmaker.settings.presentation.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/mediaFragment"
        android:name="com.example.playlistmaker.media.presentation.MediaFragment"
        android:label="fragment_media"
        tools:layout="@layout/fragment_media" />

    <fragment
        android:id="@+id/playlistFragment"
        android:name="com.example.playlistmaker.media.presentation.PlaylistFragment"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" >
    </fragment>
    <fragment
        android:id="@+id/createPlaylistFragment2"
        android:name="com.example.playlistmaker.media.presentation.CreatePlaylistFragment"
        android:label="fragment_create_playlist"
        tools:layout="@layout/fragment_create_playlist" />
    <action android:id="@+id/action_global_createPlaylistFragment2"
        app:destination="@id/createPlaylistFragment2"/>
    <dialog
        android:id="@+id/playlistBottomSheetFragment"
        android:name="com.example.playlistmaker.media.presentation.PlaylistBottomSheetFragment"
        android:label="playlist_bottom_sheet"
        tools:layout="@layout/playlist_bottom_sheet" >
        <action
            android:id="@+id/action_playlistBottomSheetFragment_to_createPlaylistFragment2"
            app:destination="@id/createPlaylistFragment2" />
    </dialog>
    <fragment
        android:id="@+id/audioPlayerFragment"
        android:name="com.example.playlistmaker.audio_player.presentation.AudioPlayerFragment"
        android:label="AudioPlayerFragment"
        tools:layout="@layout/fragment_audioplayer">
        <argument
            android:name="track"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/favoriteTracksFragment"
        android:name="com.example.playlistmaker.media.presentation.FavoriteTracksFragment"
        android:label="FavoriteTracksFragment" >
        <action
            android:id="@+id/action_favoriteTracksFragment_to_audioPlayerFragment"
            app:destination="@id/audioPlayerFragment" />
    </fragment>

</navigation>